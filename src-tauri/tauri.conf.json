{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terex UI",
  "mainBinaryName": "terex-ui",
  "version": "0.10.0",
  "identifier": "io.github.3xecutablefile.terex-ui",
  "build": {
    "beforeDevCommand": "pnpm build:cli:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:cli && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Terex UI",
        "width": 1440,
        "height": 860,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost blob:; media-src 'self' asset: https://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; frame-src 'self' http: https: asset: https://asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/terax-cli"
    ],
    "resources": {
      "../packages/ghostty-core/LICENSE": "licenses/terminal/ghostty-web.txt",
      "../packages/ghostty-core/adapted/LICENSE.ghostty": "licenses/terminal/ghostty.txt",
      "../packages/ghostty-core/adapted/LICENSE.restty": "licenses/terminal/restty.txt",
      "../src/modules/terminal/ghostty/webgl/LICENSE.xterm-js": "licenses/terminal/xterm-js.txt"
    },
    "targets": "all",
    "createUpdaterArtifacts": false,
    "copyright": "Copyright 2026 Crynta",
    "license": "Apache-2.0",
    "publisher": "Terex UI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "entitlements": "./entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Native AI terminal and system console",
    "longDescription": "Terex UI: a native purple-and-lime system console with terminals, file browsing, code editing, and AI agents.",
    "fileAssociations": [
      {
        "name": "Terex UI Document",
        "role": "Editor",
        "mimeType": "text/plain",
        "ext": [
          "json", "jsonc", "txt", "log", "csv", "tsv",
          "md", "markdown", "mdx",
          "js", "mjs", "cjs", "jsx", "ts", "tsx", "mts", "cts",
          "java", "kt", "kts", "gradle",
          "py", "rb", "php", "go", "rs", "swift", "dart", "lua",
          "c", "h", "cpp", "cc", "hpp", "hh", "cs",
          "html", "htm", "css", "scss", "sass", "less", "vue", "svelte",
          "xml", "yaml", "yml", "toml", "ini", "cfg", "conf", "properties",
          "sh", "bash", "zsh", "sql", "graphql", "proto"
        ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMzQzQTAzODY1M0MxMTEKUldRUndWT0dBem8wNGlCMU90WkdCYm8rS1N4dlp2WVQ5VmVwY0R3WjVUcWE3ZGIwbmluZjh5SDIK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/3xecutablefile/terex-ui/releases/latest/download/latest.json"
      ]
    }
  }
}
